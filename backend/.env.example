# Configuration de la base de données MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/skillforge?retryWrites=true&w=majority

# Configuration du serveur
PORT=5000

# Clé secrète pour JWT (générez une clé sécurisée)
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_complexe

# Configuration pour la production (sera défini par Render/Netlify)
NODE_ENV=production
